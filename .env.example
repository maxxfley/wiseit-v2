# Copiar a .env.local y completar. NUNCA commitear valores reales.

# Supabase — la publishable/anon key es pública por diseño; la seguridad la garantiza RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Groq — solo servidor (sin prefijo NEXT_PUBLIC_).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Modelo de Premium (opcional; por defecto openai/gpt-oss-120b).
GROQ_MODEL_PREMIUM=openai/gpt-oss-120b

# Supabase secret key — SOLO servidor, solo la usa el webhook de Paddle (saltea RLS). Nunca NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Paddle Billing (sandbox para desarrollo: claves con "_sdbx" / "test_").
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Client-side token: público por diseño (solo abre el checkout).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Solo servidor.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_YEARLY=
